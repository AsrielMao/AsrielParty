/**pages/join/join.wxss**/

.section {
  margin-bottom: 40rpx;
}

.label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 18rpx;
  padding-left: 4rpx;
}

.code-field {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0 28rpx;
}

.code-input {
  height: 120rpx;
  width: 100%;
  font-size: 44rpx;
  font-weight: 700;
  /* 房间号是等宽字符，拉开字距好看清 */
  letter-spacing: 12rpx;
  color: var(--text);
}

.code-placeholder {
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0;
  color: var(--text-3);
}

.section-head {
  margin-bottom: 20rpx;
}

.room-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
}

.room-emoji {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex: none;
}

.room-title {
  font-size: 30rpx;
  font-weight: 600;
  max-width: 380rpx;
}

.room-meta {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  color: var(--text-3);
  font-size: 22rpx;
}
