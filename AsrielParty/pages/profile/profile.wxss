/**pages/profile/profile.wxss**/

.notice {
  margin: 8rpx 0 32rpx;
  padding: 22rpx 26rpx;
  border-radius: var(--radius-sm);
  background: rgba(124, 92, 255, 0.14);
  border: 1rpx solid rgba(124, 92, 255, 0.28);
  font-size: 24rpx;
  color: #cfc6ff;
  line-height: 1.6;
}

/* ---------- 头像 ---------- */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 48rpx;
}

.avatar-btn {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
  border-radius: 50%;
}

/* 干掉小程序 button 自带的伪元素边框 */
.avatar-btn::after {
  border: none;
  display: none;
}

.avatar-btn-hover {
  opacity: 0.85;
}

.avatar-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.16);
  background: #2a2350;
}

.avatar-placeholder {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  border: 4rpx dashed rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-plus {
  font-size: 76rpx;
  font-weight: 200;
  color: rgba(255, 255, 255, 0.32);
  line-height: 1;
}

.avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7c5cff, #9d7bff);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #100e1c;
}

.avatar-edit-icon {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

.avatar-tip {
  margin-top: 22rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

/* ---------- 表单 ---------- */
.form-section {
  margin-bottom: 8rpx;
}

.label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 14rpx;
  padding-left: 4rpx;
}
