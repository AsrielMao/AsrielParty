/* components/werewolf-panel/werewolf-panel.wxss */
/*
  牌桌：左右两列座位 + 中间进程记录 + 底部操作区。

  自定义组件的宿主节点不是 flex 容器，flex:1 在这里不生效 ——
  所以这里用 height/width 100% 把面板撑满父容器（宿主由 pages/room 的 .panel-fill 撑开）。
*/

.wwp {
  height: 100%;
  width: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  border-radius: var(--radius);
  background:
    radial-gradient(120% 60% at 50% 0%, rgba(124, 92, 255, 0.16), transparent 70%),
    #14122a;
  overflow: hidden;
}

/* ============ 顶栏 ============ */

.wwp-top {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.wwp-top-day {
  font-size: 27rpx;
  font-weight: 600;
}

.wwp-top-phase {
  font-size: 23rpx;
  color: var(--text-3);
}

.wwp-top-timer {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--primary-2);
  font-variant-numeric: tabular-nums;
}

/* ============ 牌桌 ============ */

.wwp-table {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: stretch;
  gap: 10rpx;
  padding: 12rpx 10rpx;
}

/* 左右两列座位 */
.wwp-col {
  width: 148rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
}

/* 中间那栏 */
.wwp-center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* ============ 座位 ============ */

.wwp-seat {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 6rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.045);
  border: 2rpx solid transparent;
}

.wwp-seat-hover {
  background: var(--card-hover);
}

.wwp-seat.is-me {
  border-color: rgba(124, 92, 255, 0.5);
  background: rgba(124, 92, 255, 0.14);
}

/* 现在能选他 */
.wwp-seat.is-pickable {
  border-color: rgba(124, 92, 255, 0.34);
}

/* 已经选中 */
.wwp-seat.is-picked {
  border-color: var(--primary);
  background: rgba(124, 92, 255, 0.3);
}

.wwp-seat.is-out {
  opacity: 0.38;
}

.wwp-seat-face {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wwp-seat-no {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.wwp-seat-picked,
.wwp-seat-out {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 19rpx;
  border-radius: 50%;
}

.wwp-seat-picked {
  background: var(--primary);
  color: #fff;
}

.wwp-seat-out {
  background: #4a4a5a;
  color: #c8c8d4;
}

.wwp-seat-name {
  max-width: 100%;
  font-size: 20rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.wwp-seat-mark {
  font-size: 18rpx;
  line-height: 1.6;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* 我给他打的标记（只在本机显示） */
.mark-good {
  background: rgba(90, 200, 140, 0.26);
  color: #7fe0b0;
}

.mark-wolf {
  background: rgba(230, 90, 90, 0.26);
  color: #ff9a9a;
}

.mark-me {
  background: rgba(124, 92, 255, 0.32);
  color: #cbbcff;
}

.mark-bot {
  color: var(--text-3);
}

.wwp-seat-role {
  font-size: 18rpx;
  color: var(--primary-2);
}

.role-wolf {
  color: #ff9a9a;
}

/* ============ 中间的进程记录 ============ */

.wwp-log {
  flex: 1;
  min-height: 0;
}

.wwp-log-item {
  padding: 12rpx 14rpx;
  margin-bottom: 8rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.04);
  border-left: 5rpx solid rgba(255, 255, 255, 0.14);
}

.tone-night {
  border-left-color: #5a6ad0;
}

.tone-death {
  border-left-color: #e05a5a;
}

.tone-calm {
  border-left-color: #5ac88c;
}

.tone-vote {
  border-left-color: #d0a05a;
}

.tone-good {
  border-left-color: #5ac88c;
  background: rgba(90, 200, 140, 0.12);
}

.tone-wolf {
  border-left-color: #e05a5a;
  background: rgba(230, 90, 90, 0.12);
}

.wwp-log-text {
  font-size: 22rpx;
  line-height: 1.5;
}

.wwp-log-ballots {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

/* 「投给 3 号的：1、2、5」 */
.wwp-log-ballot {
  font-size: 20rpx;
  line-height: 1.6;
}

.wwp-log-ballot-to {
  color: var(--text-3);
}

.wwp-log-ballot-from {
  color: var(--primary-2);
}

.wwp-log-ballot-to.is-abstain {
  opacity: 0.75;
}

.wwp-log-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding-top: 60rpx;
}

.wwp-log-empty-title {
  font-size: 23rpx;
  color: var(--text-3);
}

.wwp-log-empty-hint {
  font-size: 20rpx;
  color: var(--text-3);
  opacity: 0.65;
}

/* ============ 我的记录（只有自己看得到） ============ */

.wwp-checks {
  flex-shrink: 0;
  padding: 12rpx 14rpx;
  border-radius: var(--radius-sm);
  background: rgba(124, 92, 255, 0.1);
  border: 1rpx solid rgba(124, 92, 255, 0.22);
}

.wwp-checks-title {
  display: block;
  font-size: 20rpx;
  color: var(--primary-2);
  margin-bottom: 6rpx;
}

.wwp-check-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 21rpx;
  padding: 3rpx 0;
}

.wwp-check-name {
  flex: 1;
  min-width: 0;
}

.wwp-check-result {
  flex-shrink: 0;
}

.wwp-check-result.is-good {
  color: #7fe0b0;
}

.wwp-check-result.is-wolf {
  color: #ff9a9a;
}

/* ============ 结算 / 结束横幅 ============ */

.wwp-banner {
  flex-shrink: 0;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.wwp-banner-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
}

.wwp-banner-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.wwp-banner.is-out {
  background: rgba(230, 90, 90, 0.14);
  border-color: rgba(230, 90, 90, 0.3);
}

.wwp-banner.is-tie {
  background: rgba(208, 160, 90, 0.14);
  border-color: rgba(208, 160, 90, 0.3);
}

.wwp-banner.is-good {
  background: rgba(90, 200, 140, 0.16);
  border-color: rgba(90, 200, 140, 0.34);
}

.wwp-banner.is-wolf {
  background: rgba(230, 90, 90, 0.16);
  border-color: rgba(230, 90, 90, 0.34);
}

/* ============ 底部操作区 ============ */

.wwp-stage {
  flex-shrink: 0;
  padding: 14rpx 20rpx 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.wwp-stage-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.wwp-stage-title {
  font-size: 26rpx;
  font-weight: 600;
}

.wwp-stage-note {
  font-size: 21rpx;
  color: var(--text-3);
}

.wwp-stage-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-3);
}

.wwp-lines {
  margin-top: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.wwp-line {
  font-size: 21rpx;
  color: var(--text-3);
}

.wwp-btns {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wwp-btn {
  flex: 1;
  min-width: 150rpx;
  text-align: center;
  padding: 18rpx 10rpx;
  border-radius: var(--radius-sm);
  font-size: 25rpx;
  background: rgba(255, 255, 255, 0.09);
}

.wwp-btn-hover {
  opacity: 0.82;
}

.wwp-btn.is-primary {
  background: var(--primary);
  color: #fff;
}

.wwp-btn.is-danger {
  background: rgba(230, 90, 90, 0.9);
  color: #fff;
}

.wwp-btn.is-ghost {
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: var(--text-3);
}

.wwp-btn.is-disabled {
  opacity: 0.42;
}

/* ============ 身份卡 ============ */

.wwp-role {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(8, 6, 20, 0.72);
}

.wwp-role-card {
  width: 480rpx;
  padding: 40rpx 32rpx 28rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background:
    radial-gradient(120% 80% at 50% 0%, rgba(124, 92, 255, 0.35), transparent 70%),
    #1c1936;
  border: 1rpx solid rgba(124, 92, 255, 0.4);
}

.wwp-role-emoji {
  font-size: 88rpx;
  line-height: 1.1;
}

.wwp-role-name {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.wwp-role-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.wwp-role-mates {
  margin-top: 22rpx;
  width: 100%;
  padding: 14rpx 18rpx;
  border-radius: var(--radius-sm);
  background: rgba(230, 90, 90, 0.14);
  border: 1rpx solid rgba(230, 90, 90, 0.28);
}

.wwp-role-mates-title {
  display: block;
  font-size: 20rpx;
  color: #ff9a9a;
  margin-bottom: 4rpx;
}

.wwp-role-mate {
  font-size: 23rpx;
  padding: 2rpx 0;
}

.wwp-role-chips {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
}

.wwp-role-chip {
  font-size: 21rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
}

.wwp-role-chip.is-used {
  opacity: 0.45;
  text-decoration: line-through;
}

.wwp-role-ok {
  margin-top: 30rpx;
  width: 100%;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--radius-sm);
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
}
