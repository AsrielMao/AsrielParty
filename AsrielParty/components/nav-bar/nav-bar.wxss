.nav-placeholder {
  width: 100%;
}

.nav-root {
  width: 100%;
  background: rgba(16, 14, 28, 0.82);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
  backdrop-filter: blur(24rpx);
}

.nav-fixed {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  z-index: 90;
}

.nav-transparent {
  background: transparent;
  border-bottom: none;
  backdrop-filter: none;
}

.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.nav-left {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  margin-left: -8rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-hover {
  background: rgba(255, 255, 255, 0.08);
}

.nav-arrow {
  width: 22rpx;
  height: 22rpx;
  margin-left: 10rpx;
  border-left: 4rpx solid #f3f0ff;
  border-bottom: 4rpx solid #f3f0ff;
  transform: rotate(45deg);
}

.nav-center {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 标题不吃点击事件，避免挡住下面的返回按钮 */
  pointer-events: none;
}

.nav-title {
  max-width: 420rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #f3f0ff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
