.seat {
  position: absolute;
  width: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 用 pos 里的百分比定位，再靠 translate 把自己摆正到那个点上 */
  transform: translate(-50%, -50%);
}

.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
}

.ring {
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
}

.ring-on {
  border-color: #35d6a4;
  box-shadow: 0 0 20rpx rgba(53, 214, 164, 0.65);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #2a2350;
  border: 3rpx solid rgba(255, 255, 255, 0.14);
  display: block;
}

.avatar-letter {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #cfc6ff;
  background: linear-gradient(135deg, #3a2f6e, #2a2350);
}

.avatar-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.03);
  border: 3rpx dashed rgba(255, 255, 255, 0.22);
}

.plus {
  font-size: 40rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.35);
  line-height: 1;
}

.is-self .avatar {
  border-color: #7c5cff;
  box-shadow: 0 0 18rpx rgba(124, 92, 255, 0.5);
}

.name {
  margin-top: 10rpx;
  max-width: 132rpx;
  font-size: 22rpx;
  color: #f3f0ff;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.is-empty .name {
  color: #6f6890;
}

.badges {
  height: 30rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.badge {
  height: 26rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 26rpx;
  white-space: nowrap;
}

.badge-owner {
  background: rgba(255, 200, 97, 0.18);
  color: #ffc861;
}

.badge-bot {
  background: rgba(124, 92, 255, 0.2);
  color: #a78bfa;
}

.badge-ready {
  background: rgba(53, 214, 164, 0.16);
  color: #35d6a4;
}

.badge-off {
  background: rgba(255, 255, 255, 0.08);
  color: #6f6890;
}

.badge-empty {
  background: transparent;
  color: #4b4766;
}

.seat-hover {
  opacity: 0.75;
}
