/**app.wxss**/

/* ============ 主题变量 ============ */
page {
  --bg: #100e1c;
  --bg-soft: #181430;
  --panel: #1e1936;
  --panel-2: #262047;
  --card: rgba(255, 255, 255, 0.055);
  --card-hover: rgba(255, 255, 255, 0.1);
  --border: rgba(255, 255, 255, 0.09);
  --border-strong: rgba(255, 255, 255, 0.18);

  --text: #f3f0ff;
  --text-2: #aaa2cc;
  --text-3: #6f6890;

  --primary: #7c5cff;
  --primary-2: #a78bfa;
  --primary-dark: #5b3fd6;
  --gold: #ffc861;
  --danger: #ff5f6d;
  --success: #35d6a4;

  --radius: 24rpx;
  --radius-lg: 32rpx;
  --radius-sm: 14rpx;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
button,
input,
textarea,
scroll-view,
navigator,
label {
  box-sizing: border-box;
}

/* ============ 布局工具类 ============ */
.page {
  min-height: 100vh;
  position: relative;
  /* 顶部背景光晕，营造派对氛围 */
  background:
    radial-gradient(120% 60% at 12% -8%, rgba(124, 92, 255, 0.32), transparent 62%),
    radial-gradient(90% 50% at 92% 4%, rgba(255, 200, 97, 0.13), transparent 60%),
    var(--bg);
}

.body {
  padding: 0 32rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.gap-s { gap: 12rpx; }
.gap-m { gap: 20rpx; }
.gap-l { gap: 32rpx; }

/* ============ 文本 ============ */
.t-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.t-section {
  font-size: 32rpx;
  font-weight: 600;
}

.t-body {
  font-size: 28rpx;
}

.t-sub {
  font-size: 24rpx;
  color: var(--text-2);
}

.t-hint {
  font-size: 22rpx;
  color: var(--text-3);
}

.t-primary { color: var(--primary-2); }
.t-gold { color: var(--gold); }
.t-danger { color: var(--danger); }

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============ 卡片 ============ */
.card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 28rpx;
}

.card-tight {
  padding: 20rpx 24rpx;
}

.card-tap {
  transition: background 0.15s ease, transform 0.15s ease;
}

.card-tap:active {
  background: var(--card-hover);
  transform: scale(0.985);
}

/* ============ 按钮 ============ */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.btn:active {
  transform: scale(0.97);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, #9d7bff 100%);
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(124, 92, 255, 0.34);
}

.btn-gold {
  background: linear-gradient(135deg, #ffb340 0%, var(--gold) 100%);
  color: #3a2500;
  box-shadow: 0 12rpx 32rpx rgba(255, 200, 97, 0.25);
}

.btn-ghost {
  background: var(--card);
  border: 1rpx solid var(--border-strong);
  color: var(--text);
}

.btn-danger {
  background: rgba(255, 95, 109, 0.16);
  border: 1rpx solid rgba(255, 95, 109, 0.4);
  color: var(--danger);
}

.btn-disabled {
  opacity: 0.4;
}

.btn-sm {
  height: 68rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
}

/* ============ 标签 ============ */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.09);
  color: var(--text-2);
}

.tag-primary {
  background: rgba(124, 92, 255, 0.22);
  color: var(--primary-2);
}

.tag-gold {
  background: rgba(255, 200, 97, 0.16);
  color: var(--gold);
}

.tag-success {
  background: rgba(53, 214, 164, 0.16);
  color: var(--success);
}

/* ============ 表单 ============ */
.field {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 0 28rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
}

.field-input {
  flex: 1;
  height: 100rpx;
  color: var(--text);
  font-size: 30rpx;
}

.field-placeholder {
  color: var(--text-3);
  font-size: 28rpx;
}

/* ============ 通用间距 ============ */
.mt-s { margin-top: 16rpx; }
.mt-m { margin-top: 28rpx; }
.mt-l { margin-top: 48rpx; }
.mb-s { margin-bottom: 16rpx; }
.mb-m { margin-bottom: 28rpx; }
.mb-l { margin-bottom: 48rpx; }

.safe-bottom {
  height: env(safe-area-inset-bottom);
}

/* ============ 空状态 ============ */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 90rpx 0;
  color: var(--text-3);
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 18rpx;
  opacity: 0.7;
}

/* ============ 弹层 ============ */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(8, 6, 16, 0.66);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: var(--panel);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  border-top: 1rpx solid var(--border-strong);
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 8rpx;
}

.sheet-sub {
  font-size: 23rpx;
  color: var(--text-3);
  text-align: center;
  margin-bottom: 24rpx;
}

